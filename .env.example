# OpenAI 兼容层配置。
# 任何 OpenAI-compatible 端点都能直接用：OpenAI / DeepSeek / 通义千问 / OpenRouter ...
OPENAI_API_KEY=sk-xxxx

# 留空则用默认 https://api.openai.com/v1
# 例如 DeepSeek: https://api.deepseek.com/v1
# 例如 通义:    https://dashscope.aliyuncs.com/compatible-mode/v1
BASE_URL=

# 模型名，按你接入的 provider 填，例如：
#   gpt-4o-mini / deepseek-chat / qwen-turbo / openrouter/...
MODEL=gpt-4o-mini
